# Copy this file to ".env" and fill in YOUR OWN Twilio values.
# Never commit the real .env file anywhere (it is in .gitignore).

# From the Twilio Console dashboard (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The Twilio phone number the assistant answers on / calls from,
# in full international format, e.g. +14155550123 or +91XXXXXXXXXX
TWILIO_PHONE_NUMBER=

# Public HTTPS base URL of this deployed server (no trailing slash),
# e.g. https://charco-call-assistant.vercel.app — used to build the
# outbound-call webhook URLs. Leave empty for local testing.
PUBLIC_BASE_URL=

# Port for the local server (default 3000)
PORT=3000
